{
  "name": "punchline-atlas",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev",
    "build": "next build",
    "vercel-build": "prisma migrate deploy && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:prod:setup": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "db:sync-youtube": "tsx scripts/sync-youtube.ts",
    "db:import": "tsx scripts/bulk-import.ts",
    "scrape:jester": "tsx scripts/scrape-jester-comedians.ts",
    "db:import-jester": "tsx scripts/import-jester-comedians.ts",
    "db:seed-all": "tsx scripts/seed-comprehensive.ts",
    "db:seed-affiliates": "tsx scripts/seed-affiliates.ts",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:phase14": "vitest run src/lib/venue-ops.test.ts src/app/api/venue-ops/",
    "test:phase15": "vitest run src/lib/short-clips.test.ts src/app/api/clips/",
    "test:phase16": "vitest run src/lib/marketing.test.ts src/app/api/marketing/",
    "test:phase17": "vitest run src/lib/accessibility.test.ts src/lib/wallet-passes.test.ts src/lib/offline-cache.test.ts src/app/api/accessibility/ src/app/api/wallet/ src/app/api/offline/",
    "test:phase18": "vitest run src/lib/international.test.ts src/app/api/international/",
    "test:lib": "vitest run src/lib/",
    "test:api": "vitest run src/app/api/",
    "test:components": "vitest run src/components/",
    "test:harness": "vitest run src/test/",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@next-auth/prisma-adapter": "^1.0.7",
    "@prisma/client": "^5.14.0",
    "@react-google-maps/api": "^2.20.8",
    "@sentry/nextjs": "^10.44.0",
    "@vercel/kv": "^3.0.0",
    "bcryptjs": "^3.0.3",
    "next": "^14.2.0",
    "next-auth": "^4.24.13",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "web-push": "^3.6.7",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@ducanh2912/next-pwa": "^10.2.9",
    "@playwright/test": "^1.58.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@vitejs/plugin-react": "^5.1.4",
    "autoprefixer": "^10",
    "dotenv": "^17.3.1",
    "eslint": "^8",
    "eslint-config-next": "^14.2.0",
    "jsdom": "^28.1.0",
    "playwright": "^1.58.2",
    "postcss": "^8",
    "prisma": "^5.14.0",
    "tailwindcss": "^3.4.0",
    "tsx": "^4.7.0",
    "typescript": "^5",
    "vitest": "^4.0.18"
  }
}
