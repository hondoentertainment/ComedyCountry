# Database (required for migrations and runtime)
DATABASE_URL="postgresql://user:password@localhost:5432/punchline_atlas"

# Direct database connection bypassing the connection pooler (used for migrations)
# Optional: production builds fall back to DATABASE_URL when this is unset.
# DIRECT_DATABASE_URL="postgresql://user:password@localhost:5432/punchline_atlas"

# YouTube Data API (for comedian channel integration)
# YOUTUBE_API_KEY="your-youtube-api-key"

# Google Maps (for venue maps)
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="your-google-maps-key"

# Bulk import API (optional; protects POST /api/import when set)
# BULK_IMPORT_API_KEY="your-secret-key"
# IMPORT_STRICT_TARGET_CITIES="true"
# IMPORT_MAX_VENUES="150"
# IMPORT_MAX_EVENTS="400"

# YouTube sync API (optional; protects POST /api/youtube/sync when set)
# YOUTUBE_SYNC_API_KEY="your-secret-key"

# NextAuth (required for sign-in and follow system)
# On Vercel, NEXTAUTH_URL should still be set explicitly even though builds can
# fall back to the deployment URL when needed.
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-nextauth-secret"

# Google OAuth (optional; enables "Continue with Google")
# GOOGLE_CLIENT_ID="your-google-client-id"
# GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Username & password sign-in works without any extra env (uses DB).

# Stripe (required for paid subscriptions)
# STRIPE_SECRET_KEY="sk_test_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."
# STRIPE_PRICE_FAN_PRO="price_..."
# STRIPE_PRICE_COMEDIAN_PRO="price_..."
# STRIPE_PRICE_COMEDIAN_PREMIUM="price_..."
# STRIPE_PRICE_VENUE_PRO="price_..."
# STRIPE_PRICE_VENUE_PREMIUM="price_..."

# Email provider (resend, sendgrid, or console for dev)
# EMAIL_PROVIDER="console"
# RESEND_API_KEY="re_..."
# SENDGRID_API_KEY="SG..."
# EMAIL_FROM="noreply@punchlineatlas.com"

# Push notifications (VAPID keys)
# NEXT_PUBLIC_VAPID_PUBLIC_KEY="..."
# VAPID_PRIVATE_KEY="..."

# Vercel KV / Upstash Redis (optional; enables persistent rate limiting across serverless instances)
# From Vercel KV or Upstash Redis dashboard when created
# KV_REST_API_URL="https://xxx.upstash.io"
# KV_REST_API_TOKEN="..."

# Cron job protection (required for location-alerts and event-reminders crons on Vercel)
# CRON_SECRET="your-cron-secret"

# Calendar feed token (optional; falls back to NEXTAUTH_SECRET if unset)
# CALENDAR_FEED_SECRET="your-calendar-feed-secret"

# Sentry (optional; no-op if unset — error monitoring)
# SENTRY_DSN="https://...@sentry.io/..."
# NEXT_PUBLIC_SENTRY_DSN="https://...@sentry.io/..."
# SENTRY_ORG="your-sentry-org"
# SENTRY_PROJECT="your-sentry-project"
# SENTRY_AUTH_TOKEN="your-sentry-auth-token"

# Runtime logging
# LOG_LEVEL="info"
