# Database
DATABASE_URL="postgresql://user:password@localhost:5432/punchline_atlas"

# YouTube Data API (for comedian channel integration)
# YOUTUBE_API_KEY="your-youtube-api-key"

# Google Maps (for venue maps)
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="your-google-maps-key"

# Bulk import API (optional; protects POST /api/import when set)
# BULK_IMPORT_API_KEY="your-secret-key"

# YouTube sync API (optional; protects POST /api/youtube/sync when set)
# YOUTUBE_SYNC_API_KEY="your-secret-key"

# NextAuth (required for sign-in and follow system)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-nextauth-secret"

# Google OAuth (optional; enables "Continue with Google")
# GOOGLE_CLIENT_ID="your-google-client-id"
# GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Username & password sign-in works without any extra env (uses DB).

# Stripe (required for paid subscriptions)
# STRIPE_SECRET_KEY="sk_test_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."
# STRIPE_PRICE_FAN_PRO="price_..."
# STRIPE_PRICE_COMEDIAN_PRO="price_..."
# STRIPE_PRICE_COMEDIAN_PREMIUM="price_..."
# STRIPE_PRICE_VENUE_PRO="price_..."
# STRIPE_PRICE_VENUE_PREMIUM="price_..."

# Email provider (resend, sendgrid, or console for dev)
# EMAIL_PROVIDER="console"
# RESEND_API_KEY="re_..."
# SENDGRID_API_KEY="SG..."
# EMAIL_FROM="noreply@punchlineatlas.com"

# Push notifications (VAPID keys)
# NEXT_PUBLIC_VAPID_PUBLIC_KEY="..."
# VAPID_PRIVATE_KEY="..."

# Cron job protection
# CRON_SECRET="your-cron-secret"
