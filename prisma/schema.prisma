// Punchline Atlas - Database Schema
// https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// Core Entities
// =============================================================================

model Venue {
  id          String   @id @default(cuid())
  name        String
  address     String?
  city        String
  state       String
  latitude    Float?
  longitude   Float?
  capacity    Int?
  website     String?
  type        VenueType @default(CLUB)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  events      Event[]
  photos      VenuePhoto[]
  socialLinks VenueSocialLink[]
  followers   VenueFollow[]
  reviews     VenueReview[]
  accessibilityTags AccessibilityTag[]

  @@index([state, city])
  @@index([type])
}

model VenuePhoto {
  id        String   @id @default(cuid())
  venueId   String
  url       String
  caption   String?
  sortOrder Int      @default(0)
  venue     Venue   @relation(fields: [venueId], references: [id], onDelete: Cascade)
}

model VenueSocialLink {
  id        String   @id @default(cuid())
  venueId   String
  platform  String   // instagram, twitter, facebook, youtube
  url       String
  venue     Venue   @relation(fields: [venueId], references: [id], onDelete: Cascade)
}

enum VenueType {
  CLUB
  THEATER
  BAR
  FESTIVAL
  OPEN_MIC
}

model Comedian {
  id              String    @id @default(cuid())
  name            String
  slug            String    @unique
  headshotUrl     String?
  bio             String?
  yearsActiveFrom Int?
  yearsActiveTo   Int?      // null = still active
  representation  String?   // agency/manager
  touringStatus   TouringStatus @default(UNKNOWN)
  website         String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  events          EventComedian[]
  genres          ComedianGenre[]
  socialLinks     ComedianSocialLink[]
  podcastLinks    ComedianPodcastLink[]
  specialReleases ComedianSpecial[]
  youtubeChannel  YouTubeChannel?
  followers       ComedianFollow[]
  tierRatings     ComedianTierRating[]
  // Phase 7
  exclusiveContent ExclusiveContent[]
  fanTips         FanTip[]
  merchItems      MerchItem[]
  bookingRequests BookingRequest[]
  setlistEntries  SetlistEntry[]
  // Phase 9
  agentRosters    AgentRoster[]
  // Phase 13: Creator Intelligence
  revenueAttributions  RevenueAttribution[]
  audienceUnifications AudienceUnification[]
  contentDistributions ContentDistribution[]
  careerMilestones     CareerMilestone[]
  financialSummaries   FinancialSummary[]
  // Podcast-to-Live Pipeline
  podcastShows         PodcastShow[]
}

enum TouringStatus {
  TOURING
  REGIONAL
  LOCAL
  RETIRED
  UNKNOWN
}

model ComedianGenre {
  id         String   @id @default(cuid())
  comedianId String
  genre      String   // dark, observational, absurdist, storyteller, etc.
  comedian   Comedian @relation(fields: [comedianId], references: [id], onDelete: Cascade)
}

model ComedianSocialLink {
  id         String   @id @default(cuid())
  comedianId String
  platform   String
  url        String
  comedian   Comedian @relation(fields: [comedianId], references: [id], onDelete: Cascade)
}

model ComedianPodcastLink {
  id         String   @id @default(cuid())
  comedianId String
  podcastName String
  episodeUrl  String?
  comedian   Comedian @relation(fields: [comedianId], references: [id], onDelete: Cascade)
}

model ComedianSpecial {
  id         String   @id @default(cuid())
  comedianId String
  title      String
  platform   String?  // netflix, hbo, youtube
  releaseYear Int?
  url        String?
  comedian   Comedian @relation(fields: [comedianId], references: [id], onDelete: Cascade)
  ratings    SpecialRating[]
}

model YouTubeChannel {
  id             String   @id @default(cuid())
  comedianId     String   @unique
  channelId      String   @unique  // YouTube channel ID
  channelUrl     String
  subscriberCount Int?
  videoCount     Int?
  lastSyncedAt   DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  comedian       Comedian @relation(fields: [comedianId], references: [id], onDelete: Cascade)
}

model Event {
  id          String   @id @default(cuid())
  venueId     String
  date        DateTime
  showtime    String?  // "8:00 PM", "7:30 PM & 10:00 PM"
  ticketUrl   String?
  priceMin    Decimal? @db.Decimal(10, 2)
  priceMax    Decimal? @db.Decimal(10, 2)
  showType    ShowType @default(HEADLINE)
  title       String?  // Custom event title if different from comedian names
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  venue       Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)
  comedians   EventComedian[]
  reviews     EventReview[]
  attendees   EventAttendance[]
  accessibilityTags AccessibilityTag[]
  // Phase 5
  tickets     Ticket[]
  ticketTypes TicketType[]
  refundPolicy RefundPolicy?
  // Phase 12
  fairPricePolicy FairPricePolicy?

  @@index([venueId])
  @@index([date])
}

model EventReview {
  id        String   @id @default(cuid())
  eventId   String
  userId    String
  rating    Int      // 1-5
  comment   String?  // optional text comment
  verifiedAttendance Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([eventId])
}

model AccessibilityTag {
  id          String   @id @default(cuid())
  eventId     String?
  venueId     String?
  type        String   // asl_interpreted, captioned, wheelchair, etc.
  description String?
  verifiedBy  String?
  verifiedAt  DateTime?
  createdAt   DateTime @default(now())

  event Event? @relation(fields: [eventId], references: [id], onDelete: Cascade)
  venue Venue? @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([venueId])
  @@index([type])
}

enum ShowType {
  HEADLINE
  FEATURE
  OPEN_MIC
  FESTIVAL
  PODCAST_LIVE
}

model EventComedian {
  id         String   @id @default(cuid())
  eventId    String
  comedianId String
  role       String   @default("headline") // headline, feature, host

  event      Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  comedian   Comedian @relation(fields: [comedianId], references: [id], onDelete: Cascade)
}

// =============================================================================
// User & Follow System (Phase 3 - NextAuth + Follows)
// =============================================================================

model User {
  id            String    @id @default(cuid())
  name          String?
  profileName   String?   // Custom display name (defaults to name if unset)
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  username      String?   @unique // For credential sign-in
  passwordHash  String?   // For credential sign-in (bcrypt)
  role          String    @default("user") // user | admin
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts          Account[]
  sessions          Session[]
  followsComedians ComedianFollow[]
  followsVenues     VenueFollow[]
  eventReviews      EventReview[]
  eventAttendances  EventAttendance[]
  comedianTierRatings ComedianTierRating[]
  notifications     Notification[]
  notificationPreference NotificationPreference?
  comedyLists       ComedyList[]
  savedLists        ComedyListSave[]
  venueReviews      VenueReview[]
  specialRatings    SpecialRating[]
  createdGroups     ShowGroup[]       @relation("ShowGroupCreator")
  groupMemberships  ShowGroupMember[]
  subscription      Subscription?
  pushSubscriptions PushSubscription[]
  followedByUsers   UserFollow[]       @relation("UserFollowing")
  followingUsers    UserFollow[]       @relation("UserFollowers")
  activityEvents    ActivityFeedItem[] @relation("ActivityActor")
  transfersSent     TicketTransfer[]   @relation("TransfersSent")
  transfersReceived TicketTransfer[]   @relation("TransfersReceived")
  authoredArticles  NewsArticle[]      @relation("AuthoredArticles")
  streamingConnections StreamingConnection[]
  streamingGenreSignals StreamingGenreSignal[]
  conversationsAsA     DirectConversation[] @relation("ConversationParticipantA")
  conversationsAsB     DirectConversation[] @relation("ConversationParticipantB")
  sentDirectMessages   DirectMessage[]      @relation("DirectMessageSender")
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@id([identifier, token])
}

model ComedianFollow {
  id         String   @id @default(cuid())
  userId     String
  comedianId String
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  comedian   Comedian @relation(fields: [comedianId], references: [id], onDelete: Cascade)

  @@unique([userId, comedianId])
}

model ComedianTierRating {
  id         String   @id @default(cuid())
  userId     String
  comedianId String
  tier       String   // S, A, B, C, D, F
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  comedian   Comedian @relation(fields: [comedianId], references: [id], onDelete: Cascade)

  @@unique([userId, comedianId])
  @@index([comedianId])
}

model VenueFollow {
  id        String   @id @default(cuid())
  userId    String
  venueId   String
  createdAt DateTime @default(now())

  user    User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  venue   Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@unique([userId, venueId])
}

// =============================================================================
// Notifications & Feed (Phase 6)
// =============================================================================

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String   // new_event, event_update, event_reminder
  title     String
  message   String
  eventId   String?
  venueId   String?
  comedianId String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([userId, createdAt])
}

model NotificationPreference {
  id               String  @id @default(cuid())
  userId           String  @unique
  inApp            Boolean @default(true)
  emailDigest      String  @default("off") // off, daily, weekly
  eventReminder24h Boolean @default(true)
  eventReminder1h  Boolean @default(true)

  user             User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// =============================================================================
// Event Attendance / RSVP (Songkick-style "I'm going")
// =============================================================================

model EventAttendance {
  id        String   @id @default(cuid())
  userId    String
  eventId   String
  status    String   @default("going") // going, interested
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
  @@index([eventId])
}

/// Tracks event reminders sent (24h and 1h before) for deduplication.
model EventReminder {
  id        String   @id @default(cuid())
  eventId   String
  userId    String
  kind      String   // "24h" | "1h"
  createdAt DateTime @default(now())

  @@unique([eventId, userId, kind])
  @@index([eventId, userId, kind])
}

// =============================================================================
// Comedy Lists (Spotify-style playlists for comedians)
// =============================================================================

model ComedyList {
  id          String   @id @default(cuid())
  userId      String
  title       String
  description String?
  isPublic    Boolean  @default(true)
  coverUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  items       ComedyListItem[]
  saves       ComedyListSave[]

  @@index([userId])
  @@index([isPublic, updatedAt])
}

model ComedyListItem {
  id         String   @id @default(cuid())
  listId     String
  comedianId String?
  eventId    String?
  venueId    String?
  note       String?
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  list       ComedyList @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@index([listId])
}

model ComedyListSave {
  id        String   @id @default(cuid())
  userId    String
  listId    String
  createdAt DateTime @default(now())

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  list      ComedyList @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@unique([userId, listId])
}

// =============================================================================
// Venue Reviews (separate from event reviews)
// =============================================================================

model VenueReview {
  id        String   @id @default(cuid())
  venueId   String
  userId    String
  rating    Int      // 1-5
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  venue     Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([venueId, userId])
  @@index([venueId])
}

// =============================================================================
// Special Ratings (user ratings for comedy specials)
// =============================================================================

model SpecialRating {
  id         String   @id @default(cuid())
  specialId  String
  userId     String
  rating     Int      // 1-5
  comment    String?
  createdAt  DateTime @default(now())

  special    ComedianSpecial @relation(fields: [specialId], references: [id], onDelete: Cascade)
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([specialId, userId])
  @@index([specialId])
}

// =============================================================================
// Group Planning (plan shows with friends)
// =============================================================================

model ShowGroup {
  id        String   @id @default(cuid())
  eventId   String
  creatorId String
  name      String?
  code      String   @unique // Shareable invite code
  createdAt DateTime @default(now())

  creator   User     @relation("ShowGroupCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  members   ShowGroupMember[]

  @@index([eventId])
  @@index([code])
}

model ShowGroupMember {
  id        String   @id @default(cuid())
  groupId   String
  userId    String
  status    String   @default("invited") // invited, going, maybe, declined
  createdAt DateTime @default(now())

  group     ShowGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
}

// =============================================================================
// Business Models & Monetization
// =============================================================================

// --- 1. Pro Subscriptions (Users & Comedians) ---
model Subscription {
  id            String   @id @default(cuid())
  userId        String   @unique
  plan          SubscriptionPlan
  status        SubscriptionStatus @default(ACTIVE)
  stripeSubId   String?  @unique  // Stripe subscription ID
  stripeCustId  String?            // Stripe customer ID
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  cancelAtPeriodEnd  Boolean @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

enum SubscriptionPlan {
  FAN_PRO          // $4.99/mo - ad-free, early access, wrapped, priority support
  COMEDIAN_PRO     // $14.99/mo - analytics dashboard, promoted profile, verified badge
  COMEDIAN_PREMIUM // $29.99/mo - everything in Pro + featured placement, API access
  VENUE_PRO        // $49.99/mo - promoted listings, analytics, event management tools
  VENUE_PREMIUM    // $99.99/mo - everything in Pro + homepage feature, priority support
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  TRIALING
}

// --- 2. Promoted Listings (Venues & Events) ---
model PromotedListing {
  id          String   @id @default(cuid())
  type        PromotionType
  venueId     String?
  eventId     String?
  comedianId  String?
  headline    String?          // Custom promo headline
  budget      Decimal  @db.Decimal(10, 2)  // Total budget
  spent       Decimal  @default(0) @db.Decimal(10, 2)
  cpmRate     Decimal  @db.Decimal(10, 4)  // Cost per thousand impressions
  impressions Int      @default(0)
  clicks      Int      @default(0)
  startDate   DateTime
  endDate     DateTime
  status      PromotionStatus @default(PENDING)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([type, status, startDate, endDate])
  @@index([venueId])
  @@index([eventId])
}

enum PromotionType {
  VENUE_FEATURED      // Featured on venues page / homepage
  EVENT_FEATURED      // Featured on schedule / city pages
  COMEDIAN_SPOTLIGHT  // Spotlight on comedians page
  SEARCH_BOOST        // Boosted in search results
  CITY_TAKEOVER       // Dominate a city's scene page
}

enum PromotionStatus {
  PENDING
  ACTIVE
  PAUSED
  COMPLETED
  REJECTED
}

// --- 3. Ticket Affiliate Revenue ---
model TicketClick {
  id        String   @id @default(cuid())
  eventId   String
  userId    String?  // null = anonymous
  referrer  String?  // page they clicked from
  ticketUrl String
  createdAt DateTime @default(now())

  @@index([eventId])
  @@index([createdAt])
}

model AffiliatePartner {
  id           String   @id @default(cuid())
  name         String   // Ticketmaster, AXS, Eventbrite, etc.
  slug         String   @unique
  baseUrl      String   // URL pattern to match
  affiliateTag String   // tag to append
  commissionPct Decimal @db.Decimal(5, 2) // e.g., 5.00 = 5%
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// --- 4. Comedian Claim & Verification ---
model ComedianClaim {
  id          String   @id @default(cuid())
  userId      String
  comedianId  String
  status      ClaimStatus @default(PENDING)
  proofUrl    String?  // Link to social proof
  proofNote   String?
  reviewedBy  String?  // Admin user ID
  reviewedAt  DateTime?
  createdAt   DateTime @default(now())

  @@unique([userId, comedianId])
  @@index([status])
}

enum ClaimStatus {
  PENDING
  APPROVED
  REJECTED
}

// --- 5. Merchandise / Tip Jar ---
model ComedianMerchLink {
  id         String   @id @default(cuid())
  comedianId String
  title      String   // "Official Merch Store", "Tip Jar"
  url        String
  type       MerchLinkType
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([comedianId])
}

enum MerchLinkType {
  MERCH_STORE    // External merch store
  TIP_JAR        // Buy me a coffee, Venmo, etc.
  PATREON        // Patreon / membership
  CAMEO          // Cameo / personalized videos
  PODCAST_SUPPORT // Podcast Patreon, etc.
}

// --- 6. Ad Placements (Display Ads) ---
model AdPlacement {
  id          String   @id @default(cuid())
  slot        String   // header, sidebar, feed-inline, event-page, etc.
  advertiser  String
  imageUrl    String
  targetUrl   String
  impressions Int      @default(0)
  clicks      Int      @default(0)
  cpmRate     Decimal  @db.Decimal(10, 4)
  startDate   DateTime
  endDate     DateTime
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@index([slot, isActive, startDate, endDate])
}

// --- 7. Analytics Events (for dashboards) ---
model AnalyticsEvent {
  id          String   @id @default(cuid())
  entityType  String   // comedian, venue, event, page
  entityId    String?
  action      String   // view, click, follow, rsvp, ticket_click, share
  userId      String?
  sessionId   String?
  metadata    String?  // JSON blob for extra data
  createdAt   DateTime @default(now())

  @@index([entityType, entityId, createdAt])
  @@index([action, createdAt])
  @@index([userId, createdAt])
}

// =============================================================================
// Push Notifications (Web Push API)
// =============================================================================

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String   // Public key
  auth      String   // Auth secret
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// =============================================================================
// Social Features (User-to-User Follows & Activity Feed)
// =============================================================================

model UserFollow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower    User     @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

model ActivityFeedItem {
  id         String   @id @default(cuid())
  actorId    String
  action     String   // rated_comedian, reviewed_event, followed_comedian, attended_event, created_list, rated_special
  entityType String   // comedian, event, venue, list, special
  entityId   String
  metadata   String?  // JSON: tier, rating, list title, etc.
  createdAt  DateTime @default(now())

  actor      User     @relation("ActivityActor", fields: [actorId], references: [id], onDelete: Cascade)

  @@index([actorId, createdAt])
  @@index([createdAt])
}

// =============================================================================
// Image Uploads
// =============================================================================

model UploadedImage {
  id          String   @id @default(cuid())
  userId      String?
  filename    String
  path        String   // /uploads/abc123.jpg
  mimeType    String
  sizeBytes   Int
  entityType  String?  // venue, comedian, user, event
  entityId    String?
  createdAt   DateTime @default(now())

  @@index([entityType, entityId])
}

// =============================================================================
// Venue Claims (parity with comedian claims)
// =============================================================================

model VenueClaim {
  id          String      @id @default(cuid())
  userId      String
  venueId     String
  status      ClaimStatus @default(PENDING)
  proofUrl    String?
  proofNote   String?
  reviewedBy  String?
  reviewedAt  DateTime?
  createdAt   DateTime    @default(now())

  @@unique([userId, venueId])
  @@index([status])
}

// =============================================================================
// Review Reactions (helpful / funny votes)
// =============================================================================

model ReviewReaction {
  id            String   @id @default(cuid())
  userId        String
  reviewType    String   // event_review, venue_review
  reviewId      String
  reactionType  String   // helpful, funny
  createdAt     DateTime @default(now())

  @@unique([userId, reviewType, reviewId])
  @@index([reviewType, reviewId])
}

// =============================================================================
// Event Waitlist (sold-out notification signup)
// =============================================================================

model EventWaitlist {
  id        String   @id @default(cuid())
  userId    String
  eventId   String
  notified  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([userId, eventId])
  @@index([eventId, notified])
}

// =============================================================================
// User Badges & Achievements
// =============================================================================

model UserBadge {
  id        String   @id @default(cuid())
  userId    String
  badge     String   // first_review, five_reviews, first_follow, ten_follows, etc.
  metadata  String?  // JSON extra data
  earnedAt  DateTime @default(now())

  @@unique([userId, badge])
  @@index([userId])
}

// =============================================================================
// Phase 5: Native Ticketing & Commerce
// =============================================================================

model Ticket {
  id            String       @id @default(cuid())
  eventId       String
  userId        String
  ticketTypeId  String
  status        TicketStatus @default(VALID)
  qrCode        String       @unique // unique QR code string
  purchasePrice Decimal      @db.Decimal(10, 2)
  stripePaymentId String?
  transferredTo String?      // email of recipient if transferred
  giftMessage   String?
  scannedAt     DateTime?    // when scanned at venue door
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  event         Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
