  ticket         Ticket              @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([sellerId])
  @@index([listingStatus])
}

enum ResaleListingStatus {
  PENDING
  APPROVED
  LISTED
  SOLD
  EXPIRED
}

// =============================================================================
// Phase 13: Discovery Flywheel
// =============================================================================

model DiscoverySignal {
  id         String              @id @default(cuid())
  userId     String
  signalType DiscoverySignalType
  entityType DiscoveryEntityType
  entityId   String
  weight     Float
  createdAt  DateTime            @default(now())

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([signalType])
}

enum DiscoverySignalType {
  VIEW
  CLICK
  ATTEND
  FOLLOW
  CLIP_WATCH
  SHARE
  REVIEW
  CHECKIN
  PURCHASE
}

enum DiscoveryEntityType {
  EVENT
  COMEDIAN
  VENUE
  CLIP
  PODCAST
}

model PersonalizedFeed {
  id         String               @id @default(cuid())
  userId     String
  feedType   PersonalizedFeedType
  items      Json
  computedAt DateTime             @default(now())
  expiresAt  DateTime

  @@unique([userId, feedType])
  @@index([expiresAt])
}

enum PersonalizedFeedType {
  FOR_YOU
  HAPPENING_TONIGHT
  TRENDING_NEAR_YOU
  FRIENDS_ATTENDING
}

model SocialProof {
  id              String              @id @default(cuid())
  entityType      DiscoveryEntityType
  entityId        String
  friendsAttending Int                @default(0)
  totalAttending  Int                 @default(0)
  trendingScore   Float               @default(0)
  trustScore      Float               @default(0)
  buzzLevel       BuzzLevel           @default(LOW)
  updatedAt       DateTime            @updatedAt

  @@unique([entityType, entityId])
  @@index([buzzLevel])
  @@index([trendingScore])
}

enum BuzzLevel {
  LOW
  MEDIUM
  HIGH
  VIRAL
}

model DiscoveryBoost {
  id              String              @id @default(cuid())
  entityType      DiscoveryEntityType
  entityId        String
  boostType       DiscoveryBoostType
  boostMultiplier Float
  expiresAt       DateTime
  createdAt       DateTime            @default(now())

  @@index([entityType, entityId])
  @@index([expiresAt])
}

enum DiscoveryBoostType {
  NEW_COMEDIAN
  RETURNING_FAVORITE
  FRIEND_RECOMMENDED
  TRENDING
  EDITORIAL_PICK
}

model UserDiscoveryProfile {
  id                String   @id @default(cuid())
  userId            String   @unique
  preferredGenres   Json     @default("[]")
  preferredVenues   Json     @default("[]")
  preferredDays     Json     @default("[]")
  attributeWeights  Json     @default("{}")
  explanationCache  Json     @default("[]")
  profileVersion    String   @default("v2")
  averageSpend      Float    @default(0)
  discoveryOpenness Float    @default(0.5)
  lastComputedAt    DateTime @default(now())

  @@index([userId])
}

model EventExperienceFeedback {
  id                 String   @id @default(cuid())
  eventId            String
  userId             String
  verifiedAttendance Boolean  @default(false)
  setQuality         Int?
  crowdFit           Int?
  roomVibe           Int?
  pacing             Int?
  valueForPrice      Int?
  openerStrength     Int?
  surpriseGuests     Boolean?
  wouldRecommend     Boolean?
  notes              String?
  moderationStatus   String   @default("visible") // visible | flagged | hidden
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([eventId, userId])
  @@index([eventId, moderationStatus])
  @@index([userId, createdAt])
}

model SceneInsightSnapshot {
  id                String   @id @default(cuid())
  city              String
  state             String
  slug              String   @unique
  sceneScore        Float    @default(0)
  momentumScore     Float    @default(0)
  loyaltyScore      Float    @default(0)
  varietyScore      Float    @default(0)
  avgTicketPrice    Float    @default(0)
  activeVenues      Int      @default(0)
  upcomingShows     Int      @default(0)
  topAttributes     Json     @default("[]")
  featuredComedians Json     @default("[]")
  lastComputedAt    DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([city, state])
  @@index([sceneScore])
  @@index([momentumScore])
}

// =============================================================================
// Comedy Analytics Engine
// =============================================================================

enum CrowdReaction {
  SILENT
  CHUCKLES
  LAUGHING
  ROARING
  STANDING_OVATION
}

enum BenchmarkMetric {
  AVG_ATTENDANCE
  AVG_SPEND
  RETURN_RATE
  SATISFACTION
}

model PerformanceMetric {
  id            String        @id @default(cuid())
  comedianId    String
  eventId       String
  bitTitle      String
  laughScore    Int           // 0-100
  crowdReaction CrowdReaction
  audienceSize  Int
  city          String
  date          DateTime
  createdAt     DateTime      @default(now())

  @@index([comedianId])
  @@index([eventId])
  @@index([comedianId, date])
  @@index([city])
}

model AudienceHeatmap {
  id              String   @id @default(cuid())
  comedianId      String
  country         String   @default("US")
  city            String
  state           String
  fanCount        Int
  engagementScore Float
  lastUpdated     DateTime @default(now())

  @@unique([comedianId, country, city, state])
  @@index([comedianId])
  @@index([state])
}

model RevenueForecast {
  id              String   @id @default(cuid())
  eventId         String
  predictedSales  Int
  actualSales     Int?
  confidenceScore Float    // 0-1
  factors         Json     // JSON object with prediction factors
  createdAt       DateTime @default(now())

  @@index([eventId])
}

model VenueBenchmark {
  id             String          @id @default(cuid())
  venueId        String
  metric         BenchmarkMetric
  value          Float
  period         String          // "2024-Q1", "2024-01", "2024"
  percentileRank Float           // 0-100

  @@unique([venueId, metric, period])
  @@index([venueId])
  @@index([metric, period])
}

model ComedianAnalytics {
  id             String   @id @default(cuid())
  comedianId     String
  totalShows     Int
  totalAudience  Int
  avgRating      Float
  topCities      Json     // [{ city, state, count }]
  genreBreakdown Json     // [{ genre, percentage }]
  growthRate     Float    // percentage growth period over period
  period         String   // "2024-Q1", "2024", "all-time"
  createdAt      DateTime @default(now())

  @@unique([comedianId, period])
  @@index([comedianId])
}

model IndustryTrend {
  id            String   @id @default(cuid())
  category      String   // "shows", "attendance", "genre", "emerging"
  metric        String   // specific metric name
  value         Float
  previousValue Float
  changePercent Float
  period        String   // "2024-Q1", "2024-01"
  region        String?  // null = national
  createdAt     DateTime @default(now())

  @@unique([category, metric, period, region])
  @@index([category, period])
  @@index([region])
}

// =============================================================================
// Podcast-to-Live Pipeline
// =============================================================================

model PodcastShow {
  id              String          @id @default(cuid())
  comedianId      String
  title           String
  feedUrl         String
  platform        PodcastPlatform
  subscriberCount Int             @default(0)
  lastEpisodeAt   DateTime?
  synced          Boolean         @default(false)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  comedian        Comedian        @relation(fields: [comedianId], references: [id], onDelete: Cascade)
  episodes        PodcastEpisode[]
  liveRecordings  LiveRecordingSession[]

  @@index([comedianId])
}

enum PodcastPlatform {
  APPLE
  SPOTIFY
  YOUTUBE
  RSS
}

model PodcastEpisode {
  id               String   @id @default(cuid())
  podcastId        String
  title            String
  description      String?
  audioUrl         String
  publishedAt      DateTime
  durationSeconds  Int      @default(0)
  guestComedianIds String[] @default([])
  listenerCount    Int      @default(0)
  topCities        Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  podcast          PodcastShow @relation(fields: [podcastId], references: [id], onDelete: Cascade)
  ticketLinks      PodcastTicketLink[]

  @@index([podcastId, publishedAt])
}

model PodcastTicketLink {
  id        String   @id @default(cuid())
  episodeId String
  eventId   String
  clipId    String?
  clicks    Int      @default(0)
  purchases Int      @default(0)
  revenue   Float    @default(0)
  createdAt DateTime @default(now())

  episode   PodcastEpisode @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  @@index([episodeId])
  @@index([eventId])
}

model LiveRecordingSession {
  id                    String              @id @default(cuid())
  eventId               String
  podcastId             String
  consentRequired       Boolean             @default(true)
  consentCollected      Boolean             @default(false)
  audioQuality          AudioQuality        @default(STANDARD)
  distributionPlatforms Json?
  status                LiveRecordingStatus @default(PLANNED)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  podcast               PodcastShow         @relation(fields: [podcastId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([podcastId])
}

enum AudioQuality {
  STANDARD
  ENHANCED
  STUDIO
}

enum LiveRecordingStatus {
  PLANNED
  RECORDING
  POST_PRODUCTION
  PUBLISHED
}

// =============================================================================
// Phase 14: Creator Intelligence Dashboard
// =============================================================================

model RevenueAttribution {
  id           String            @id @default(cuid())
  comedianId   String
  sourceType   RevenueSourceType
  sourceId     String?
  revenueType  RevenueType
  amount       Float
  attributedAt DateTime          @default(now())
  createdAt    DateTime          @default(now())

  comedian     Comedian          @relation(fields: [comedianId], references: [id], onDelete: Cascade)

  @@index([comedianId, attributedAt])
  @@index([comedianId, sourceType])
}

enum RevenueSourceType {
  CLIP
  PODCAST
  SOCIAL
  REFERRAL
  ORGANIC
}

enum RevenueType {
  TICKET
  MERCH
  TIP
  SUBSCRIPTION
}

model AudienceUnification {
  id             String           @id @default(cuid())
  comedianId     String
  platform       AudiencePlatform
  platformUserId String?
  email          String?
  followerCount  Int?
  engagementRate Float?
  lastSyncedAt   DateTime         @default(now())
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  comedian       Comedian         @relation(fields: [comedianId], references: [id], onDelete: Cascade)

  @@index([comedianId, platform])
  @@index([email])
}

enum AudiencePlatform {
  TIKTOK
  INSTAGRAM
  YOUTUBE
  PODCAST
  TICKET_BUYER
  MERCH_BUYER
}

model ContentDistribution {
  id                    String    @id @default(cuid())
  comedianId            String
  contentId             String
  title                 String
  platforms             Json
  scheduledAt           DateTime?
  distributedAt         DateTime?
  performanceByPlatform Json?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  comedian              Comedian  @relation(fields: [comedianId], references: [id], onDelete: Cascade)

  @@index([comedianId, contentId])
  @@index([comedianId, scheduledAt])
}

model CareerMilestone {
  id           String   @id @default(cuid())
  comedianId   String
  milestone    String
  achievedAt   DateTime @default(now())
  metric       String
  value        Float
  previousBest Float?
  createdAt    DateTime @default(now())

  comedian     Comedian @relation(fields: [comedianId], references: [id], onDelete: Cascade)

  @@index([comedianId, achievedAt])
}

model FinancialSummary {
  id                  String   @id @default(cuid())
  comedianId          String
  period              String
  ticketRevenue       Float    @default(0)
  merchRevenue        Float    @default(0)
  tipRevenue          Float    @default(0)
  subscriptionRevenue Float    @default(0)
  totalRevenue        Float    @default(0)
  expenses            Float?
  netIncome           Float?
  taxEstimate         Float?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  comedian            Comedian @relation(fields: [comedianId], references: [id], onDelete: Cascade)

  @@unique([comedianId, period])
  @@index([comedianId])
}

// =============================================================================
// Phase 19: Streaming Platform Sync
// =============================================================================

model StreamingConnection {
  id              String   @id @default(cuid())
  userId          String
  platform        String   // SPOTIFY | APPLE_MUSIC
  platformUserId  String
  accessToken     String
  refreshToken    String?
  connectedAt     DateTime @default(now())
  lastSyncedAt    DateTime?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, platform])
  @@index([userId])
}

model StreamingGenreSignal {
  id        String   @id @default(cuid())
  userId    String
  platform  String   // SPOTIFY | APPLE_MUSIC
  genre     String
  weight    Float    @default(0)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, platform])
  @@index([userId, genre])
}

// =============================================================================
// Phase 20: Direct Messaging
// =============================================================================

model DirectConversation {
  id             String   @id @default(cuid())
  participantAId String
  participantBId String
  lastMessageAt  DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  participantA   User     @relation("ConversationParticipantA", fields: [participantAId], references: [id], onDelete: Cascade)
  participantB   User     @relation("ConversationParticipantB", fields: [participantBId], references: [id], onDelete: Cascade)
  messages       DirectMessage[]

  @@unique([participantAId, participantBId])
  @@index([participantAId, lastMessageAt])
  @@index([participantBId, lastMessageAt])
}

model DirectMessage {
  id             String    @id @default(cuid())
  conversationId String
  senderId       String
  content        String
  readAt         DateTime?
  createdAt      DateTime  @default(now())

  conversation   DirectConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User               @relation("DirectMessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([senderId])
}
