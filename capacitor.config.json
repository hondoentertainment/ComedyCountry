{
  "appId": "com.punchlineatlas.app",
  "appName": "Punchline Atlas",
  "webDir": "out",
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2000,
      "backgroundColor": "#0d0d0d",
      "showSpinner": true,
      "spinnerColor": "#d4a843"
    },
    "PushNotifications": {
      "presentationOptions": ["badge", "sound", "alert"]
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#0d0d0d"
    }
  },
  "ios": {
    "contentInset": "automatic",
    "preferredContentMode": "mobile"
  },
  "android": {
    "backgroundColor": "#0d0d0d"
  }
}
