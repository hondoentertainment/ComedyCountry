      "id": "com.punchlineatlas.app"
    },
    {
      "platform": "itunes",
      "url": "https://apps.apple.com/app/punchline-atlas/id000000000"
    }
  ],
  "prefer_related_applications": false,
  "protocol_handlers": [
    {
      "protocol": "web+punchline",
      "url": "/%s"
    }
  ],
  "share_target": {
    "action": "/share",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
