  "shortcuts": [
    {
      "name": "Browse Shows",
      "short_name": "Shows",
      "description": "Browse upcoming comedy shows",
      "url": "/schedule",
      "icons": [{ "src": "/icons/shortcut-shows.png", "sizes": "96x96" }]
    },
    {
      "name": "Discover Comedians",
      "short_name": "Comedians",
      "description": "Explore comedians and follow your favorites",
      "url": "/comedians",
      "icons": [{ "src": "/icons/shortcut-comedians.png", "sizes": "96x96" }]
    },
    {
      "name": "My Tickets",
      "short_name": "Tickets",
      "description": "View your purchased tickets",
      "url": "/tickets",
      "icons": [{ "src": "/icons/shortcut-tickets.png", "sizes": "96x96" }]
    },
    {
      "name": "Nearby Shows",
      "short_name": "Near Me",
      "description": "Find comedy shows near your location",
      "url": "/map",
      "icons": [{ "src": "/icons/shortcut-map.png", "sizes": "96x96" }]
    }
  ],
  "screenshots": [
    {
      "src": "/screenshots/home-wide.png",
